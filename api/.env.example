# Database Configuration (Pflicht, nur DB_PORT hat einen Standardwert)
DB_HOST=central_postgres
DB_PORT=5432
DB_NAME=manga_inventory
DB_USER=manga_admin
DB_PASSWORD=change-me

# API Configuration
PORT=3000
NODE_ENV=production

# Security (Pflicht)
API_KEY=your-secure-api-key-here-change-this
JWT_SECRET=your-long-random-jwt-secret-change-this
ALLOWED_ORIGINS=https://manga.phudevelopement.xyz,https://manga.intern.phudevelopement.xyz

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
